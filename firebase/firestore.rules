rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function user(){ return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function role(){ return user().role; }
    function tenant(){ return user().tenantId; }
    function active(){ return signedIn() && user().ativo == true; }
    function superadmin(){ return active() && role() == 'superadmin'; }
    function sameTenant(tid){ return active() && tenant() == tid; }
    match /usuarios/{uid} {
      allow read: if superadmin() || (signedIn() && request.auth.uid == uid);
      allow write: if superadmin();
    }
    match /tenants/{tid} {
      allow read: if superadmin() || sameTenant(tid);
      allow write: if superadmin();
      match /{col}/{doc} {
        allow read, write: if superadmin() || sameTenant(tid);
      }
    }
  }
}
